    "黑色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色"
          }
        }
      }
    },
    "默认关闭，和 Mac 版一样。打开后，自动把太亮的天空和窗外收进胶片能记录的范围，主体亮度基本不变。下面的「场景置位」打开后改为手动。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default, as on the Mac. When on, it brings a too-bright sky or window into what the film can record, keeping the subject's brightness. Turning on “Scene placement” below makes it manual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，和 Mac 版一样。打开后，自动把太亮的天空和窗外收进胶片能记录的范围，主体亮度基本不变。下面的「场景置位」打开后改为手动。"
          }
        }
      }
    },
    "齿孔全景": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprocket panorama"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "齿孔全景"
          }
        }
