          }
        }
      }
    },
    "黑白摄影的经典滤镜：黄、橙、红让天空更暗、云更突出，绿让肤色和树叶更有层次。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The classic black-and-white filters: yellow, orange and red darken the sky and lift the clouds; green separates skin tones and foliage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑白摄影的经典滤镜：黄、橙、红让天空更暗、云更突出，绿让肤色和树叶更有层次。"
          }
        }
      }
    },
    "黑白相纸": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silver paper"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑白相纸"
          }
        }
      }
    },
    "黑白相纸只能印黑白胶片": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Silver paper prints black-and-white film only"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑白相纸只能印黑白胶片"
          }
        }
      }
    },
    "黑白胶片只有一层银盐，没有彩色成色剂。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black-and-white film has one silver layer and no colour couplers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑白胶片只有一层银盐，没有彩色成色剂。"
